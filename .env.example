# Copy to .env.local for local dev. Don't commit .env.local.
# All vars also need to be set in Vercel project env for production.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL — public, safe to expose
NEXT_PUBLIC_SUPABASE_URL=https://kypdukvvlykwqspquqqk.supabase.co

# Anonymous public key — safe to expose; subject to RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key — SERVER ONLY, bypasses RLS. Used by scripts/seed.ts and
# any future server actions that need privileged writes. Never put this
# behind a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── GitHub (Phase 4) ────────────────────────────────────────────────────
# Personal access token (classic, `repo` scope). Read-only use; never reaches
# the browser. Reads commits/PRs/issues for halos with a GitHub integration.
GITHUB_PAT=ghp_...

# ── Modal (Phase 5) ─────────────────────────────────────────────────────
# Production Modal endpoint that exposes the agent dispatch function.
# Populated after `modal deploy modal/atlas_agents.py` in Phase 5.
MODAL_AGENT_URL=https://<workspace>--atlas-agents-dispatch.modal.run

# ── App ─────────────────────────────────────────────────────────────────
# Used for absolute URLs in magic-link emails, OAuth callbacks, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
