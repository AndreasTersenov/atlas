{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "npx supabase db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:types": "npx supabase gen types typescript --linked > lib/database.types.ts",
    "bridge": "tsx scripts/atlas-bridge.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "chokidar": "^3.6.0",
    "dotenv": "^17.4.2",
    "next": "16.2.6",
    "picomatch": "^4.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.22.1",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
