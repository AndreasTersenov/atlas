{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // Dead v1 code, scheduled for deletion in G.1.f (V2_SHOWCASE_PLAN §D
  // Phase 2). Excluding now so the build doesn't fail when G.1.f removes
  // @supabase/*, chokidar, etc. — the import sites in these files would
  // otherwise tank tsc.
  "exclude": [
    "node_modules",
    "lib/supabase-server.ts",
    "lib/supabase-browser.ts",
    "lib/supabase-admin.ts",
    "lib/database.types.ts",
    "lib/atlas-mapping.ts",
    "lib/atlas-transcript.ts",
    "lib/github.ts",
    "lib/safe-next.ts",
    "scripts/atlas-bridge.ts",
    "scripts/seed.ts"
  ]
}
